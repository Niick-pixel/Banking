{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aufwind",
  "mainBinaryName": "Aufwind",
  "version": "../package.json",
  "identifier": "cr.aufwind.finance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aufwind",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Aufwind",
    "category": "Finance",
    "shortDescription": "Personal finance tracker for Costa Rica",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1MTQ3Mjc1MTY3OEYwNkEKUldScThIZ1dkWElVUlJ5V2o5VXBNQzNLSUxHdmxYR1k1WnhOYUZoZktCMHQ1UEhRNWYyNEgrSHUK",
      "endpoints": [
        "https://github.com/niick-pixel/banking/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
